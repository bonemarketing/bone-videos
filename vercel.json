{
  "cleanUrls": false,
  "headers": [
    { "source": "/videos/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=604800" },
      { "key": "Access-Control-Allow-Origin", "value": "*" }
    ] }
  ],
  "redirects": [
    { "source": "/", "destination": "https://bonemarketing.net/", "statusCode": 302 }
  ]
}
